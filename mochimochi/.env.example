DATABASE_URL="file:./dev.db"
# 本番（PostgreSQL）のみ：直接接続の接続文字列（README参照。Neon なら空でOK）
# DIRECT_URL=""
# ログイン情報の署名・チェックインQRの生成に使う（32文字以上のランダム文字列）
SESSION_SECRET="change-me-to-a-long-random-string-0123456789"
# 本番の初回に /setup で最初のスタッフを作るときのキー（16文字以上）
SETUP_TOKEN=""
# 公開URL（チェックインQRの読み取り先）
APP_BASE_URL="http://localhost:3000"
# ── 公式LINE（LIFF）を作ったら設定。未設定の間はニックネームだけの仮登録で使える ──
NEXT_PUBLIC_LIFF_ID=""
LINE_LOGIN_CHANNEL_ID=""
