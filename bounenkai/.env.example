DATABASE_URL="file:./dev.db"
# 本番（PostgreSQL）のみ：直接接続の接続文字列（Neon なら空でOK）
# DIRECT_URL=""
# 管理画面ログインの署名用（32文字以上のランダム文字列）
SESSION_SECRET="change-me-to-a-long-random-string-0123456789"
# 本番の初回に /setup で最初のスタッフを作るときのキー（16文字以上）
SETUP_TOKEN=""
# 公開URL（通知の中のリンクに使う）
APP_BASE_URL="http://localhost:3000"

# ── 予約が入ったときの LINE 通知（LINE公式アカウントの Messaging API・プッシュメッセージ） ──
# 未設定なら送らずに管理画面「通知履歴」にだけ残す
LINE_CHANNEL_ACCESS_TOKEN=""
# 通知を受け取る人の LINE ユーザーID（U から始まる33文字）。カンマ区切りで複数可
LINE_NOTIFY_TO=""

# ── お客さんへの確認メール（Resend）。未設定なら送らずに「通知履歴」にだけ残す ──
RESEND_API_KEY=""
# 送信元（Resend で認証したドメインのアドレス）例: 9High福山 <yoyaku@example.com>
MAIL_FROM=""
